# Copy to .env and adjust for your machine (compose reads .env automatically).

# Grafana UI port on the host. 3000 is Grafana's default; this machine runs
# something else on 3000, so the local stack uses 3001.
GRAFANA_PORT=3001

# Grafana admin login (local-only stack, bound to 127.0.0.1).
GRAFANA_ADMIN_PASSWORD=admin

# Optional overrides:
# ORDER_TRACKER_PORT=8000
# ORDER_TRACKER_TAG=local
# ORDER_TRACKER_SUBNET=10.215.24.0/24
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# TEMPO_PORT=3200
